name: run-experiments
on:
  workflow_dispatch:
    inputs:
      sha:
        description: Commit SHA to run
        required: true
        type: string
      jobs:
        description: Comma-separated job files relative to jobs/ (e.g. example.yml)
        required: true
        type: string
      skip_smoke:
        description: Skip the smoke stage
        type: boolean
        default: false

jobs:
  run:
    uses: {{ github_owner }}/{{ devbox_repo }}/.github/workflows/run-experiments.yml@main
    with:
      sha: {% raw %}${{ inputs.sha }}{% endraw %}
      jobs: {% raw %}${{ inputs.jobs }}{% endraw %}
      skip_smoke: {% raw %}${{ inputs.skip_smoke }}{% endraw %}
    secrets: inherit
