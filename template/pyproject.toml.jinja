[project]
name = "{{ project_name }}"
version = "0.1.0"
requires-python = "=={{ python_version }}.*"
dependencies = [
  # 2.9 is the first torch with Python 3.14 wheels. No macOS x86_64 wheels (Intel Macs aren't a target).
  "torch>=2.9",
  "pydantic>=2",
  "pyyaml",
  "modal",
]

[dependency-groups]
dev = ["ruff", "pyright", "pytest", "types-PyYAML"]

[build-system]
requires = ["hatchling"]
build-backend = "hatchling.build"

[tool.hatch.build.targets.wheel]
packages = ["src/{{ package_name }}"]

[tool.pyright]
typeCheckingMode = "basic"
include = ["src", "tests"]

[tool.ruff]
line-length = 100
