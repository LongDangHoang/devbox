[Unit]
Description=Pull devbox scripts from S3 and run bootstrap
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
TimeoutStartSec=1800
ExecStart=/bin/bash -c '. /etc/devbox/boot.conf && export AWS_DEFAULT_REGION=$AWS_REGION && aws s3 sync "$SCRIPTS_S3" /opt/devbox/scripts --delete && chmod +x /opt/devbox/scripts/*.sh && exec /opt/devbox/scripts/bootstrap.sh'

[Install]
WantedBy=multi-user.target
