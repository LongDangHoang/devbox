{
  "allowManagedHooksOnly": true,
  "allowManagedMcpServersOnly": true,
  "allowedMcpServers": [],
  "env": { "DISABLE_AUTOUPDATER": "1" },
  "permissions": {
    "disableBypassPermissionsMode": "disable",
    "deny": [
      "Read(//etc/devbox/env)",
      "Read(//data/claude/.credentials.json)",
      "Read(~/.claude/.credentials.json)",
      "Edit(//data/claude/settings.json)",
      "Edit(~/.claude/settings.json)",
      "Edit(~/.bashrc)",
      "Edit(~/.profile)",
      "Edit(~/.bash_profile)",
      "Edit(~/.gitconfig)",
      "Edit(~/.config/**)",
      "Edit(~/.local/**)",
      "Edit(//data/repo/.git/hooks/**)",
      "Edit(//data/repo/.git/config)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "allowUnsandboxedCommands": false,
    "enableWeakerNestedSandbox": false,
    "enableWeakerNetworkIsolation": false,
    "filesystem": {
      "allowManagedReadPathsOnly": true,
      "allowWrite": ["/data/cache", "/data/shared"],
      "denyRead": [
        "/etc/devbox/env",
        "/data/claude/.credentials.json",
        "~/.claude/.credentials.json"
      ]
    },
    "network": {
      "allowManagedDomainsOnly": true,
      "allowAllUnixSockets": false,
      "allowedDomains": [
        "github.com",
        "*.github.com",
        "*.githubusercontent.com",
        "pypi.org",
        "files.pythonhosted.org",
        "download.pytorch.org",
        "astral.sh",
        "*.astral.sh",
        "huggingface.co",
        "*.huggingface.co",
        "hf.co",
        "*.hf.co"
      ],
      "deniedDomains": ["169.254.169.254"]
    }
  }
}
