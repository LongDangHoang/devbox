region                   = "<region>" # e.g. ap-southeast-2; must match backend.hcl (state bucket in this region) and infra/iam/deployer-boundary.json
vpc_id                   = "vpc-xxxxxxxx"
subnet_id                = "subnet-xxxxxxxx" # needs outbound internet (public subnet with auto-assign IPv4, or NAT)
default_instance_type    = "m7g.xlarge"
default_data_gb          = 50
idle_minutes             = 30
github_owner             = "OWNER"
agent_github_username    = "MACHINE_USER"
budget_email             = "you@example.com"
monthly_budget_usd       = 30
