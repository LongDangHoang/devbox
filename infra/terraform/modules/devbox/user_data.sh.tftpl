#!/bin/bash
# First boot only (cloud-init). Installs infra/scripts/* and enables setup-boot.service.
set -euo pipefail
install -d -m 0755 /opt/devbox/scripts
%{ for f, content in files ~}
cat > /opt/devbox/scripts/${f} <<'DEVBOX_EOF'
${content}
DEVBOX_EOF
%{ endfor ~}
chmod 0755 /opt/devbox/scripts/*.sh
install -m 0644 /opt/devbox/scripts/setup-boot.service /etc/systemd/system/setup-boot.service
systemctl daemon-reload
systemctl enable --now --no-block setup-boot.service
