#!/bin/bash
set -euxo pipefail
mkdir -p /etc/devbox
cat > /etc/devbox/boot.conf <<'EOF'
SCRIPTS_S3=s3://${bucket}/${prefix}
AWS_REGION=${region}
EOF
command -v aws >/dev/null || snap install aws-cli --classic
aws s3 cp --region ${region} s3://${bucket}/${prefix}/setup-boot.service /etc/systemd/system/setup-boot.service
systemctl daemon-reload && systemctl enable --now setup-boot.service
